<launch>
    <arg name="mode" default="desktop" />
    <arg name="rviz" default="true" />
    <arg name="map_name" default="my_map" />
    <arg name="localization" default="false" />
    <arg name="nav" default="false" />
    <arg name="explore" default="false" />
    <let name="urdf_path" value="$(find-pkg-share my_robot_description)/urdf/my_robot.urdf.xacro" />
    <let name="rviz_config_path" value="$(find-pkg-share my_robot_description)/rviz/urdf_config.rviz" />
    <let name="db_path" value="/home/cuong/.ros/rtabmap_$(var map_name).db" />
    <let name="nav2_params_path" value="$(find-pkg-share my_robot_bringup)/config/nav2_params.yaml" />
    <let name="explore_params_path" value="$(find-pkg-share my_robot_bringup)/config/explore_params.yaml" />
    <group if="$(eval '\'$(var mode)\' == \'desktop\'')">
        <node pkg="rviz2" exec="rviz2" name="rviz2" output="screen"
              args="-d $(var rviz_config_path)" if="$(var rviz)"/>
    </group>
    <group if="$(eval '\'$(var mode)\' == \'raspberry\'')">
        <node pkg="robot_state_publisher" exec="robot_state_publisher">
            <param name="robot_description" value="$(command 'xacro $(var urdf_path)')"/>
            <param name="publish_frequency" value="50.0"/>
            <param name="use_sim_time" value="false"/>
        </node>
        <node pkg="odom_to_tf" exec="odom_to_tf" name="odom_to_tf" output="screen">
            <param name="use_sim_time" value="false"/>
        </node>
        <node pkg="joint_state_publisher" exec="joint_state_publisher" name="joint_state_publisher">
            <param name="source_list" value="['/joint_states']"/>
            <param name="rate" value="50"/>
            <param name="use_sim_time" value="false"/>
        </node>
        <node pkg="kinect_ros2" exec="kinect_ros2_node" name="kinect_ros2" namespace="kinect" output="screen"/>
        <node pkg="topic_tools" exec="throttle" name="depth_throttle" output="screen"
              args="messages /kinect/depth/image_raw 10.0 /kinect/depth/image_throttled"/>
        <node pkg="depthimage_to_laserscan" exec="depthimage_to_laserscan_node" name="depthimage_to_laserscan">
            <remap from="depth" to="/kinect/depth/image_throttled"/>
            <remap from="depth_camera_info" to="/kinect/depth/camera_info"/>
            <param name="range_min" value="0.5"/>
            <param name="range_max" value="3.5"/>
            <param name="scan_height" value="10"/>
            <param name="output_frame" value="kinect_link"/>
        </node>
        <!-- RTAB-Map Mapping Mode (localization == false) -->
        <group if="$(eval '\'$(var localization)\' == \'false\'')">
            <node pkg="rtabmap_slam" exec="rtabmap" name="rtabmap" output="screen" args="--delete_db_on_start">
                <param name="database_path" value="$(var db_path)"/>
                <param name="frame_id" value="base_footprint"/>
                <param name="odom_frame_id" value="odom"/>
                <param name="subscribe_depth" value="true"/>
                <param name="subscribe_scan" value="true"/>
                <param name="approx_sync" value="true"/>
                <param name="approx_sync_max_interval" value="0.2"/>
                <param name="use_sim_time" value="false"/>
                <param name="Rtabmap/DetectionRate" value="0.5" type="str"/>
                <param name="Grid/Sensor" value="0" type="str"/>
                <param name="Grid/RangeMax" value="3.5" type="str"/>
                <param name="Vis/MinInliers" value="20" type="str"/>
                <param name="RGBD/AngularUpdate" value="0.1" type="str"/>
                <param name="RGBD/LinearUpdate" value="0.1" type="str"/>
                <remap from="rgb/image" to="/kinect/image_raw"/>
                <remap from="rgb/camera_info" to="/kinect/camera_info"/>
                <remap from="depth/image" to="/kinect/depth/image_raw"/>
                <remap from="depth/camera_info" to="/kinect/depth/camera_info"/>
                <remap from="scan" to="/scan"/>
                <remap from="odom" to="/odom"/>
            </node>
        </group>
        <!-- RTAB-Map Resume Mapping Mode (localization == true) -->
        <group if="$(eval '\'$(var localization)\' == \'true\'')">
            <node pkg="rtabmap_slam" exec="rtabmap" name="rtabmap" output="screen">
                <param name="database_path" value="$(var db_path)"/>
                <param name="frame_id" value="base_footprint"/>
                <param name="odom_frame_id" value="odom"/>
                <param name="subscribe_depth" value="true"/>
                <param name="subscribe_scan" value="true"/>
                <param name="approx_sync" value="true"/>
                <param name="approx_sync_max_interval" value="0.2"/>
                <param name="use_sim_time" value="false"/>
                <param name="Mem/IncrementalMemory" value="true" type="str"/>
                <param name="Rtabmap/DetectionRate" value="0.5" type="str"/>
                <param name="Grid/Sensor" value="0" type="str"/>
                <param name="Grid/RangeMax" value="3.5" type="str"/>
                <param name="Vis/MinInliers" value="20" type="str"/>
                <param name="RGBD/AngularUpdate" value="0.1" type="str"/>
                <param name="RGBD/LinearUpdate" value="0.1" type="str"/>
                <remap from="rgb/image" to="/kinect/image_raw"/>
                <remap from="rgb/camera_info" to="/kinect/camera_info"/>
                <remap from="depth/image" to="/kinect/depth/image_raw"/>
                <remap from="depth/camera_info" to="/kinect/depth/camera_info"/>
                <remap from="scan" to="/scan"/>
                <remap from="odom" to="/odom"/>
            </node>
        </group>
        <!-- RTAB-Map Pure Localization Mode (localization == pure_localization) -->
        <group if="$(eval '\'$(var localization)\' == \'pure_localization\'')">
            <node pkg="rtabmap_slam" exec="rtabmap" name="rtabmap" output="screen">
                <param name="database_path" value="$(var db_path)"/>
                <param name="frame_id" value="base_footprint"/>
                <param name="odom_frame_id" value="odom"/>
                <param name="subscribe_depth" value="true"/>
                <param name="subscribe_scan" value="true"/>
                <param name="approx_sync" value="true"/>
                <param name="approx_sync_max_interval" value="0.2"/>
                <param name="use_sim_time" value="false"/>
                <param name="Mem/IncrementalMemory" value="false" type="str"/>
                <param name="Rtabmap/DetectionRate" value="0.5" type="str"/>
                <param name="Grid/Sensor" value="0" type="str"/>
                <param name="Grid/RangeMax" value="3.5" type="str"/>
                <param name="Vis/MinInliers" value="20" type="str"/>
                <param name="RGBD/AngularUpdate" value="0.1" type="str"/>
                <param name="RGBD/LinearUpdate" value="0.1" type="str"/>
                <remap from="rgb/image" to="/kinect/image_raw"/>
                <remap from="rgb/camera_info" to="/kinect/camera_info"/>
                <remap from="depth/image" to="/kinect/depth/image_raw"/>
                <remap from="depth/camera_info" to="/kinect/depth/camera_info"/>
                <remap from="scan" to="/scan"/>
                <remap from="odom" to="/odom"/>
            </node>
        </group>
        <group if="$(var nav)">
            <node pkg="nav2_controller" exec="controller_server" name="controller_server" output="screen">
                <param from="$(var nav2_params_path)"/>
                <remap from="cmd_vel" to="cmd_vel_nav"/>
            </node>
            <node pkg="nav2_planner" exec="planner_server" name="planner_server" output="screen">
                <param from="$(var nav2_params_path)"/>
            </node>
            <node pkg="nav2_behaviors" exec="behavior_server" name="behavior_server" output="screen">
                <param from="$(var nav2_params_path)"/>
            </node>
            <node pkg="nav2_bt_navigator" exec="bt_navigator" name="bt_navigator" output="screen">
                <param from="$(var nav2_params_path)"/>
            </node>
            <node pkg="nav2_velocity_smoother" exec="velocity_smoother" name="velocity_smoother" output="screen">
                <param from="$(var nav2_params_path)"/>
                <remap from="cmd_vel" to="cmd_vel_nav"/>
                <remap from="cmd_vel_smoothed" to="cmd_vel"/>
            </node>
            <node pkg="nav2_smoother" exec="smoother_server" name="smoother_server" output="screen">
                <param from="$(var nav2_params_path)"/>
            </node>
            <node pkg="nav2_lifecycle_manager" exec="lifecycle_manager" name="lifecycle_manager_navigation" output="screen">
                <param name="autostart" value="true"/>
                <param name="node_names" value="[controller_server, smoother_server, planner_server, behavior_server, bt_navigator, velocity_smoother]"/>
                <param name="use_sim_time" value="false"/>
            </node>
        </group>
        <group if="$(var explore)">
            <node pkg="explore_lite" exec="explore" name="explore_node" output="screen">
                <param from="$(var explore_params_path)"/>
            </node>
        </group>
    </group>
</launch>
