<launch>
    <!-- 1. Khởi động Robot (Driver ESP32 + Diff Drive Controller) -->
    <include file="$(find-pkg-share my_robot_bringup)/launch/my_robot.launch.xml"/>

    <!-- 2. Driver Kinect Camera -->
    <node pkg="kinect_ros2" exec="kinect_ros2_node" name="kinect_ros2" output="screen"/>

    <!-- 3. Node Đồng bộ (RGBD Sync) -->
    <node pkg="rtabmap_sync" exec="rgbd_sync" name="rgbd_sync" output="screen">
        <param name="approx_sync" value="true"/>
        <param name="queue_size" value="50"/>
        <param name="approx_sync_max_interval" value="0.1"/>
        
        <remap from="rgb/image" to="/image_raw"/>
        <remap from="depth/image" to="/depth/image_raw"/>
        <remap from="rgb/camera_info" to="/camera_info"/>
        <remap from="rgbd_image" to="rgbd_image"/>
    </node>

    <!-- 4. RTAB-Map SLAM -->
    <node pkg="rtabmap_slam" exec="rtabmap" name="rtabmap" output="screen" args="--delete_db_on_start">
        <param name="frame_id" value="base_footprint"/>
        <param name="subscribe_depth" value="false"/>
        <param name="subscribe_rgb" value="false"/>
        <param name="subscribe_rgbd" value="true"/>
        <param name="subscribe_odom" value="true"/>
        <param name="queue_size" value="50"/>
        
        <param name="RGBD/LinearUpdate" value="'0.0'"/>
        <param name="RGBD/AngularUpdate" value="'0.0'"/>
        
        <param name="Vis/MinInliers" value="'12'"/>
        <param name="approx_sync" value="true"/>
        <param name="Mem/RehearsalSimilarity" value="'0.30'"/>

        <remap from="rgbd_image" to="rgbd_image"/>
        <remap from="odom" to="/diff_drive_controller/odom"/>
    </node>
</launch>
