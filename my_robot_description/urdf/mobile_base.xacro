<?xml version="1.0"?>
<robot name="my_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="base_length" value="0.3" />
  <xacro:property name="base_width" value="0.2" />
  <xacro:property name="base_height" value="0.065" />
  <xacro:property name="wheel_radius" value="0.034" />
  <xacro:property name="wheel_length" value="0.025" />

  <!-- Gốc tọa độ trên mặt đất -->
  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}" />
      </geometry>
      <origin xyz="-0.105 0 0.0775" rpy="0 0 0" />
      <material name="semi_black">
        <color rgba="0 0 0 0.75" />
      </material>
    </visual>
  </link>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="left_wheel">
    <visual>
      <geometry>
        <cylinder length="${wheel_length}" radius="${wheel_radius}" />
      </geometry>
      <origin xyz="0 0.1175 0.034" rpy="1.5708 0 0" />
      <material name="blue">
        <color rgba="0.0 0.0 1.0 1.0" />
      </material>
    </visual>
  </link>

  <link name="right_wheel">
    <visual>
      <geometry>
        <cylinder length="${wheel_length}" radius="${wheel_radius}" />
      </geometry>
      <origin xyz="0 -0.1175 0.034" rpy="1.5708 0 0" />
      <material name="blue">
        <color rgba="0.0 0.0 1.0 1.0" />
      </material>
    </visual>
  </link>

  <link name="front_ball">
    <visual>
      <geometry>
        <sphere radius="0.03" />
      </geometry>
      <origin xyz="-0.21 0 0.03" rpy="0 0 0" />
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1.0" />
      </material>
    </visual>
  </link>

  <!-- Kinect Physical Link -->
  <link name="kinect_link">
    <visual>
      <geometry>
        <box size="0.06 0.28 0.04"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <material name="red">
          <color rgba="1 0 0 1"/>
      </material>
    </visual>
  </link>

  <joint name="kinect_joint" type="fixed">
    <parent link="base_link"/>
    <child link="kinect_link"/>
    <origin xyz="0 0 0.13" rpy="0 0 0"/>
  </joint>

  <!-- Kinect Optical Frame (Z forward, X right, Y down) -->
  <link name="kinect_depth"/>
  <joint name="kinect_depth_joint" type="fixed">
    <parent link="kinect_link"/>
    <child link="kinect_depth"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <joint name="left_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <joint name="right_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <joint name="front_ball_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_ball"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="-0.105 0 0.0775" rpy="0 0 0"/>
  </joint>

</robot>
